# FinSage BFF Server — Production Environment Variables
#
# Copy this file to .env.production and fill in real values before deploying.
# Never commit the real .env.production to source control.
#
# Required variables — the server will misbehave or crash if any of these are missing.

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://finsage_user:CHANGE_ME@db-host:5432/finsage_prod"

# Redis connection string used by the document-processing worker.
# Format: redis://<host>:<port>  or  rediss://<host>:<port>  for TLS
REDIS_URL="redis://redis-host:6379"

# Secret used to sign and verify JWT tokens.
# Use a long, random string (e.g. openssl rand -hex 64).
# Rotating this value invalidates all existing sessions.
JWT_SECRET="CHANGE_ME_use_a_long_random_secret"

# Base URL of the AI engine service (no trailing slash).
# In Kubernetes, this is typically the internal ClusterIP service name.
AI_ENGINE_URL="http://ai-engine:8000"

# Port the BFF server listens on inside the container.
# The Dockerfile EXPOSEs 4000 — change both if you use a different port.
PORT=4000
