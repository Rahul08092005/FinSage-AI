// Person 1 (Aditi) owns this file.
// Phase 2: adds Account, Transaction, Budget, Goal on top of the Phase 1 User model.
// Phase 3+ adds Document, AdvisorSession, HealthScore, etc. per the ERD.
// Phase 5: adds taxRegime and annualIncome to User for Financial Plan support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String
  monthlySalary Decimal?
  // Phase 5: tax profile fields — nullable so existing users are unaffected.
  // taxRegime must be 'old' or 'new' (enforced at the API layer, not the DB layer).
  taxRegime    String?
  annualIncome Decimal?
  createdAt     DateTime      @default(now())

  accounts     Account[]
  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]
  documents    Document[]
  households   Household[]
  householdMembers HouseholdMember[]

  @@map("users")
}

model Account {
  id          String        @id @default(uuid())
  userId      String
  name        String
  accountType String        // e.g. "bank", "upi", "cash", "credit_card"
  provider    String?
  createdAt   DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("accounts")
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  accountId       String?
  amount          Decimal
  category        String
  transactionDate DateTime
  description     String
  source          String   @default("manual") // manual | csv | ocr | splitwise | bank
  createdAt       DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  // Phase 4: composite index on the two columns used by every list/filter query
  @@index([userId, transactionDate])
  @@map("transactions")
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  category    String
  monthlyLimit Decimal
  currency    String   @default("INR")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category])
  @@map("budgets")
}

model Goal {
  id           String   @id @default(uuid())
  userId       String
  title        String
  targetAmount Decimal
  startDate    DateTime @default(now())
  endDate      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("goals")
}

model Document {
  id                    String    @id @default(uuid())
  userId                String
  title                 String
  docType               String    // "receipt" | "bank_statement" | "other"
  fileUrl               String    // local path for now; swappable for S3 later
  status                String    @default("QUEUED") // QUEUED|PROCESSING|COMPLETED|NEEDS_REVIEW|FAILED
  extractedJson         Json?
  confidence            Float?
  uploadedAt            DateTime  @default(now())
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  ocrError              String?
  transactionId         String?

  user User @relation(fields: [userId], references: [id])

  @@map("documents")
}

model Household {
  id        String            @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime          @default(now())

  owner     User              @relation(fields: [ownerId], references: [id])
  members   HouseholdMember[]
  expenses  HouseholdExpense[]

  @@map("households")
}

model HouseholdMember {
  id          String                  @id @default(uuid())
  householdId String
  userId      String?
  name        String
  email       String
  role        String                  @default("MEMBER") // OWNER | MEMBER
  status      String                  @default("ACCEPTED") // ACCEPTED | PENDING
  joinedAt    DateTime                @default(now())

  household   Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?                   @relation(fields: [userId], references: [id])
  paidExpenses HouseholdExpense[]
  splits      HouseholdExpenseSplit[]

  @@unique([householdId, email])
  @@map("household_members")
}

model HouseholdExpense {
  id            String                  @id @default(uuid())
  householdId   String
  payerMemberId String
  description   String
  amount        Decimal
  category      String                  @default("General")
  expenseDate   DateTime                @default(now())
  splitMethod   String                  @default("EQUAL") // EQUAL | CUSTOM
  createdAt     DateTime                @default(now())

  household     Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payerMember   HouseholdMember         @relation(fields: [payerMemberId], references: [id], onDelete: Cascade)
  splits        HouseholdExpenseSplit[]

  @@map("household_expenses")
}

model HouseholdExpenseSplit {
  id              String           @id @default(uuid())
  expenseId       String
  memberId        String
  allocatedAmount Decimal

  expense         HouseholdExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member          HouseholdMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("household_expense_splits")
}
