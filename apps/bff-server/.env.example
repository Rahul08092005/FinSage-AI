DATABASE_URL="postgresql://finsage:finsage_dev_pw@localhost:5432/finsage_db"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change_this_in_real_env"
PORT=4000
AI_ENGINE_URL="http://localhost:8000"

# ────────────────────────────────────────────────────────────────────────────
# Phase 6 — External Financial API Keys
# ────────────────────────────────────────────────────────────────────────────

# mfapi.in (Mutual Fund NAV) — FREE, no key required.
# Optional: override the default scheme code (119598 = Axis Bluechip Fund).
MFAPI_SCHEME_CODE=119598

# exchangerate-api.com (Forex rates) — FREE tier (1500 req/month, no CC).
# Sign up at: https://www.exchangerate-api.com/
# REQUIRED to enable the /api/v1/market/forex endpoint.
# If not set, the forex adapter fails fast with a clear error (no silent fallback).
EXCHANGERATE_API_KEY=

# commodities-api.com (Gold / Silver / Crude Oil prices in INR) — FREE tier.
# Sign up at: https://commodities-api.com/
# REQUIRED to enable the /api/v1/market/commodities endpoint.
# If not set, the commodity adapter fails fast with a clear error (no silent fallback).
COMMODITIES_API_KEY=

# World Bank Open Data API (Economic indicators) — FREE, no key required.
# No env var needed. Country defaults to "IN" (India); override via ?country= query param.

# Optional: set to "debug" to enable verbose adapter logging
LOG_LEVEL=info
